# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=matchhire_dev
DB_USER=matchhire
DB_PASSWORD=matchhire
DB_HOST=localhost
DB_PORT=5432

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache (Redis; DB 1 keeps it separate from the broker DB 0)
REDIS_CACHE_URL=redis://localhost:6379/1

# File storage (local by default; set AWS_* for S3/R2-compatible storage)
MEDIA_ROOT=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Resume processing (proposed defaults pending approval)
RESUME_MAX_UPLOAD_BYTES=10485760
RESUME_TASK_STATUS_TTL_SECONDS=86400
RESUME_MIN_TEXT_LENGTH=20
RESUME_UPLOAD_THROTTLE_RATE=10/hour
AUTH_THROTTLE_RATE=20/minute

# JWT cookie transport (browser clients)
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
